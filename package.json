{
  "name": "md-reader",
  "productName": "MD Reader",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight, offline Markdown reader for Windows.",
  "author": {
    "name": "Abhijith KM",
    "url": "https://github.com/abhijithkm"
  },
  "license": "MIT",
  "homepage": "https://github.com/abhijithkm/md-reader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhijithkm/md-reader.git"
  },
  "bugs": {
    "url": "https://github.com/abhijithkm/md-reader/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "pack": "electron-builder --win --x64 --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "checksums": "node scripts/checksums.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "hast-util-to-string": "^3.0.1",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.61.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
